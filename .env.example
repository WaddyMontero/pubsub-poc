SERVICE_NAME=radar
VENDOR_NAME=domx
MESSAGE_BUS=kafka
WAREHOUSE_SINK=postgres
AUDIT_SINK=local
AUDIT_BATCH_MIN_MESSAGES=15
AUDIT_LOCAL_DIR=./tmp/ingestion_audit
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=vendor.change-events
KAFKA_GROUP_ID=domxtractor
POSTGRES_DSN=postgresql://poc:poc@localhost:5432/poc
VENDOR_API_URL=http://localhost:8001
RADAR_URL=http://localhost:8000
GENERATOR_INTERVAL_SECONDS=3
GENERATOR_COUNT=10

# GCP mode
GCP_PROJECT_ID=your-project-id
PUBSUB_TOPIC_ID=vendor-change-events
PUBSUB_SUBSCRIPTION_ID=vendor-change-events-extractor
BIGQUERY_DATASET=vendor_ingestion_poc
BIGQUERY_TABLE=landing_records
AUDIT_GCS_BUCKET=your-audit-bucket
